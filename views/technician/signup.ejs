<%- include('partials/head') %>
<main class="login-page">
  <form class="form-card login-card" action="/technician/signup" method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <span class="brand-mark">PS</span>
    <h1>Create Technician Account</h1>
    <% if (error) { %><div class="form-errors"><p><%= error %></p></div><% } %>
    <label>Name<input name="name" value="<%= form.name || '' %>" required></label>
    <label>Email<input type="email" name="email" value="<%= form.email || '' %>" required></label>
    <label>Password<input type="password" name="password" minlength="8" required></label>
    <label>Confirm Password<input type="password" name="confirmPassword" minlength="8" required></label>
    <button class="btn primary" type="submit">Create Account</button>
    <a class="btn ghost" href="/technician/login">Back To Login</a>
  </form>
</main>
</body>
</html>
