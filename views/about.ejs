<%- include('partials/head') %>
<%- include('partials/nav') %>
<main>
  <section class="page-hero">
    <p class="eyebrow">About us</p>
    <h1>Roadside help from a mobile technician</h1>
    <p><%= settings.businessName %> is built around one clear promise: professional roadside assistance delivered where the customer is located.</p>
  </section>
  <section class="split-section">
    <div>
      <h2>No storefront. No towing. We come to you.</h2>
      <p>The owner currently performs the services personally, which keeps communication direct and service accountable. The system is designed so more technicians can be added later as the business grows.</p>
    </div>
    <div class="info-panel">
      <img class="panel-image" src="/images/brand/problem-solvers-payment-board.png" alt="Problem Solvers Roadside Assistance service and payment information board">
      <h3>Service Focus</h3>
      <p>Tire change, jump start, battery testing, battery replacement, lockout, fuel delivery, tire inflation, and light roadside repairs.</p>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
