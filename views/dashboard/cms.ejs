<%- include('partials/head') %>
<%- include('partials/nav') %>
<main class="dashboard-main">
  <section class="manager-hero">
    <p class="eyebrow">Website Management</p>
    <h1>Website CMS</h1>
    <p>Edit your website content from one place. These sections are ready to expand when you want to work on the CMS.</p>
  </section>

  <section class="cms-grid" aria-label="Website CMS sections">
    <article class="cms-card">
      <h2>Homepage</h2>
      <p>Edit hero title, buttons, text, and homepage content.</p>
      <a class="btn primary" href="/dashboard/settings">Edit</a>
    </article>

    <article class="cms-card">
      <h2>Services</h2>
      <p>Edit service names, prices, descriptions, and service areas.</p>
      <a class="btn primary" href="/dashboard/settings#pricing">Edit</a>
    </article>

    <article class="cms-card">
      <h2>About Us</h2>
      <p>Edit company information, business hours, and service area text.</p>
      <a class="btn primary" href="/dashboard/settings">Edit</a>
    </article>

    <article class="cms-card">
      <h2>Policies</h2>
      <p>Edit Privacy Policy, Terms, Refund Policy, and service disclaimer content.</p>
      <a class="btn primary" href="/dashboard/settings">Edit</a>
    </article>

    <article class="cms-card">
      <h2>SEO</h2>
      <p>Edit page title, keywords, favicon, and meta description.</p>
      <a class="btn primary" href="/dashboard/settings">Edit</a>
    </article>

    <article class="cms-card">
      <h2>Header & Footer</h2>
      <p>Edit phone number, text number, menu details, and footer information.</p>
      <a class="btn primary" href="/dashboard/settings">Edit</a>
    </article>

    <article class="cms-card">
      <h2>Images</h2>
      <p>Upload homepage banners, logo, gallery images, and review photos.</p>
      <a class="btn primary" href="/dashboard/settings#photos">Edit</a>
    </article>

    <article class="cms-card">
      <h2>Contact</h2>
      <p>Edit email, hours, Google Map, review link, and contact information.</p>
      <a class="btn primary" href="/dashboard/settings">Edit</a>
    </article>
  </section>
</main>
</body>
</html>
