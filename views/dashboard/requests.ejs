<%- include('partials/head') %>
<%- include('partials/nav') %>
<%
  const formatDetails = (details) => {
    if (!details || typeof details !== 'object') return '';
    return Object.entries(details)
      .filter(([, value]) => value)
      .map(([key, value]) => {
        const label = key.replace(/([A-Z])/g, ' $1').replace(/^./, (char) => char.toUpperCase());
        return `${label}: ${value}`;
      })
      .join(' | ');
  };
%>
<main class="dashboard-main">
  <div class="dashboard-topline">
    <h1><%= currentStatus || 'Service Requests' %></h1>
    <a class="btn secondary" href="/dashboard/requests">All Requests</a>
  </div>
  <section class="dashboard-panel">
    <div class="table-wrap">
      <table>
        <thead><tr><th>Customer</th><th>Phone</th><th>Vehicle</th><th>Problem</th><th>Location</th><th>Distance</th><th>Quote</th><th>Payment</th><th>Status</th><th>Update</th></tr></thead>
        <tbody>
          <% items.forEach((item) => { %>
            <tr>
              <td><%= item.customerName %></td>
              <td><a href="tel:<%= item.phone %>"><%= item.phone %></a></td>
              <td><%= item.vehicleYear %> <%= item.vehicleColor || '' %> <%= item.vehicleMake %> <%= item.vehicleModel %></td>
              <td>
                <%= item.problem %>
                <% const serviceDetailText = formatDetails(item.serviceDetails); %>
                <% if (serviceDetailText) { %><br><small><%= serviceDetailText %></small><% } %>
              </td>
              <td><a target="_blank" rel="noreferrer" href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(item.currentLocation) %>">Open Map</a></td>
              <td>
                <%= item.distanceMiles ? `${item.distanceMiles} mi` : 'Not estimated' %>
                <% if (item.travelTimeMinutes) { %><br><small><%= item.travelTimeMinutes %> min</small><% } %>
              </td>
              <td>
                <%= item.totalPrice ? `$${item.totalPrice}` : 'Not quoted' %>
                <% if (item.basePrice) { %><br><small>Base $<%= item.basePrice %><% if (item.travelFee) { %> + travel $<%= item.travelFee %><% } %></small><% } %>
              </td>
              <td>
                <%= item.preferredPaymentMethod || 'Not selected' %>
                <br><small><%= item.paymentStatus || 'Payment Pending' %></small>
              </td>
              <td><span class="status-pill"><%= item.status %></span></td>
              <td>
                <form class="inline-form" action="/dashboard/requests/<%= item._id %>/status?_method=PATCH" method="post">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <select name="status"><% statuses.forEach((status) => { %><option <%= status === item.status ? 'selected' : '' %>><%= status %></option><% }) %></select>
                  <input name="note" placeholder="Note">
                  <button type="submit">Save</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</main>
</body>
</html>
