<%- include('partials/head') %>
<%- include('partials/nav') %>
<%
  const formatDetails = (details) => {
    if (!details || typeof details !== 'object') return '';
    return Object.entries(details)
      .filter(([, value]) => value)
      .map(([key, value]) => {
        const label = key.replace(/([A-Z])/g, ' $1').replace(/^./, (char) => char.toUpperCase());
        return `${label}: ${value}`;
      })
      .join(' | ');
  };
  const formatDateTime = (value) => value
    ? new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value))
    : 'Not recorded';
  const mapQuery = (item) => item.location?.lat && item.location?.lng
    ? `${item.location.lat},${item.location.lng}`
    : item.currentLocation;
%>
<main class="dashboard-main">
  <div class="dashboard-topline">
    <h1><%= currentStatus || 'Service Requests' %></h1>
    <a class="btn secondary" href="/dashboard/requests">All Requests</a>
  </div>
  <section class="dashboard-panel">
    <div class="table-wrap">
      <table>
        <thead><tr><th>Request</th><th>Customer</th><th>Actions</th><th>Vehicle</th><th>Problem</th><th>Location</th><th>Distance / ETA</th><th>Quote</th><th>Payment</th><th>Status</th><th>Photos</th><th>Update</th></tr></thead>
        <tbody>
          <% items.forEach((item) => { %>
            <tr>
              <td>
                <strong><%= item.requestId || item.referenceNumber || item._id %></strong>
                <br><small><%= formatDateTime(item.createdAt) %></small>
              </td>
              <td>
                <%= item.customerName %>
                <br><a href="tel:<%= item.phone %>"><%= item.phone %></a>
              </td>
              <td>
                <a class="btn secondary dashboard-action-btn" href="tel:<%= item.phone %>">Call</a>
                <a class="btn ghost dashboard-action-btn" href="sms:<%= item.phone %>">Text</a>
              </td>
              <td><%= item.vehicleYear %> <%= item.vehicleColor || '' %> <%= item.vehicleMake %> <%= item.vehicleModel %></td>
              <td>
                <%= item.problem %>
                <% const serviceDetailText = formatDetails(item.serviceDetails); %>
                <% if (serviceDetailText) { %><br><small><%= serviceDetailText %></small><% } %>
              </td>
              <td>
                <%= item.currentLocation %>
                <% if (item.location?.lat && item.location?.lng) { %><br><small><%= item.location.lat %>, <%= item.location.lng %></small><% } %>
                <br><a target="_blank" rel="noreferrer" href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(mapQuery(item)) %>">Open Map</a>
                <br><a target="_blank" rel="noreferrer" href="https://www.google.com/maps/dir/?api=1&destination=<%= encodeURIComponent(mapQuery(item)) %>">Navigate</a>
              </td>
              <td>
                <%= item.distanceMiles ? `${item.distanceMiles} mi` : 'Not estimated' %>
                <% if (item.travelTimeMinutes) { %><br><small><%= item.travelTimeMinutes %> min</small><% } %>
                <% if (item.estimatedArrivalMinutes) { %><br><small>ETA <%= item.estimatedArrivalMinutes %> min</small><% } %>
              </td>
              <td>
                <%= item.totalPrice ? `$${item.totalPrice}` : 'Not quoted' %>
                <% if (item.basePrice) { %><br><small>Base $<%= item.basePrice %><% if (item.travelFee) { %> + travel $<%= item.travelFee %><% } %></small><% } %>
              </td>
              <td>
                <%= item.preferredPaymentMethod || 'Not selected' %>
                <br><small><%= item.paymentStatus || 'Payment Pending' %></small>
              </td>
              <td><span class="status-pill"><%= item.status %></span></td>
              <td>
                <% if (item.photoPaths?.length) { %>
                  <div class="dashboard-photo-list">
                    <% item.photoPaths.forEach((photoPath) => { %>
                      <a href="<%= photoPath %>" target="_blank" rel="noreferrer"><img src="<%= photoPath %>" alt="Customer uploaded service photo"></a>
                    <% }) %>
                  </div>
                <% } else { %>
                  <small>No photos</small>
                <% } %>
              </td>
              <td>
                <form class="inline-form" action="/dashboard/requests/<%= item._id %>/status?_method=PATCH" method="post">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <select name="status"><% statuses.forEach((status) => { %><option <%= status === item.status ? 'selected' : '' %>><%= status %></option><% }) %></select>
                  <input name="note" placeholder="Note">
                  <textarea name="internalNotes" placeholder="Internal notes"><%= item.internalNotes || '' %></textarea>
                  <button type="submit">Save</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</main>
</body>
</html>
