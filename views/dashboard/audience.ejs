<%- include('partials/head') %>
<%- include('partials/nav') %>
<main class="dashboard-main">
  <div class="dashboard-topline audience-hero">
    <div>
      <p class="eyebrow">Website Analytics</p>
      <h1>Visitor Journeys</h1>
      <p class="muted-copy">Grouped by visitor/session so owner checks, ad clicks, landing pages, service interest, and booking attempts are easier to verify.</p>
    </div>
    <div class="manager-actions small">
      <a class="btn secondary" href="/dashboard/audience?days=1">24 Hours</a>
      <a class="btn secondary" href="/dashboard/audience?days=7">7 Days</a>
      <a class="btn secondary" href="/dashboard/audience?days=30">30 Days</a>
    </div>
  </div>

  <section class="stat-grid audience-stat-grid">
    <article class="stat-card metric-card"><span>Page Visits</span><strong><%= audience.visits %></strong></article>
    <article class="stat-card metric-card"><span>Real Visitor Visits</span><strong><%= audience.customerVisits %></strong></article>
    <article class="stat-card metric-card"><span>Owner Visits</span><strong><%= audience.ownerVisits %></strong></article>
    <article class="stat-card metric-card"><span>Known Visitors</span><strong><%= audience.uniqueVisitors %></strong></article>
  </section>

  <section class="request-manager-list audience-manager-list" aria-label="Visitor visit breakdown">
    <details class="request-manager-card audience-manager-card">
      <summary class="request-manager-summary audience-manager-summary">
        <span class="request-summary-customer">Page Visits</span>
        <span class="request-summary-id"><%= audience.visits %> visits</span>
        <span class="request-summary-service">All pages</span>
        <span class="request-summary-payment is-paid">Tracked</span>
        <span class="request-summary-date">All page views</span>
      </summary>
      <div class="request-manager-body audience-manager-body">
        <section class="request-manager-main audience-manager-main">
          <div class="audience-expanded-list">
            <% audience.pageVisitEvents.forEach((event) => { %>
              <article class="audience-expanded-row">
                <strong><%= event.pageLabel %></strong>
                <span><b>IP:</b> <%= event.ipLabel %></span>
                <span><b>Source:</b> <%= event.sourceLabel %></span>
                <span><b>Time:</b> <%= event.displayTime %></span>
                <small><%= event.path || '-' %></small>
              </article>
            <% }) %>
            <% if (!audience.pageVisitEvents.length) { %><p class="muted-copy">No page visits in this window.</p><% } %>
          </div>
        </section>
      </div>
    </details>

    <details class="request-manager-card audience-manager-card">
      <summary class="request-manager-summary audience-manager-summary">
        <span class="request-summary-customer">Real Visitor Visits</span>
        <span class="request-summary-id"><%= audience.customerVisits %> visits</span>
        <span class="request-summary-service">Not owner</span>
        <span class="request-summary-payment is-paid">Visitors</span>
        <span class="request-summary-date">All visitor page views</span>
      </summary>
      <div class="request-manager-body audience-manager-body">
        <section class="request-manager-main audience-manager-main">
          <div class="audience-expanded-list">
            <% audience.customerVisitEvents.forEach((event) => { %>
              <article class="audience-expanded-row">
                <strong><%= event.pageLabel %></strong>
                <span><b>IP:</b> <%= event.ipLabel %></span>
                <span><b>Source:</b> <%= event.sourceLabel %></span>
                <span><b>Time:</b> <%= event.displayTime %></span>
                <small><%= event.path || '-' %></small>
              </article>
            <% }) %>
            <% if (!audience.customerVisitEvents.length) { %><p class="muted-copy">No real visitor visits in this window.</p><% } %>
          </div>
        </section>
      </div>
    </details>

    <details class="request-manager-card audience-manager-card">
      <summary class="request-manager-summary audience-manager-summary">
        <span class="request-summary-customer">Owner Visits</span>
        <span class="request-summary-id"><%= audience.ownerVisits %> visits</span>
        <span class="request-summary-service">Your checks</span>
        <span class="request-summary-payment is-unpaid">Owner</span>
        <span class="request-summary-date">Matched owner IP/session</span>
      </summary>
      <div class="request-manager-body audience-manager-body">
        <section class="request-manager-main audience-manager-main">
          <div class="audience-expanded-list">
            <% audience.ownerVisitEvents.forEach((event) => { %>
              <article class="audience-expanded-row">
                <strong><%= event.pageLabel %></strong>
                <span><b>IP:</b> <%= event.ipLabel %></span>
                <span><b>Source:</b> <%= event.sourceLabel %></span>
                <span><b>Time:</b> <%= event.displayTime %></span>
                <small><%= event.path || '-' %></small>
              </article>
            <% }) %>
            <% if (!audience.ownerVisitEvents.length) { %><p class="muted-copy">No owner visits in this window.</p><% } %>
          </div>
        </section>
      </div>
    </details>

    <details class="request-manager-card audience-manager-card">
      <summary class="request-manager-summary audience-manager-summary">
        <span class="request-summary-customer">Known Visitors</span>
        <span class="request-summary-id"><%= audience.uniqueVisitors %> visitors</span>
        <span class="request-summary-service">Grouped journeys</span>
        <span class="request-summary-payment is-paid">Sessions</span>
        <span class="request-summary-date">All visitor groups</span>
      </summary>
      <div class="request-manager-body audience-manager-body">
        <section class="request-manager-main audience-manager-main">
          <div class="audience-expanded-list">
            <% audience.knownVisitorRows.forEach((journey) => { %>
              <article class="audience-expanded-row">
                <strong><%= journey.visitorLabel %></strong>
                <span><b>IP:</b> <%= journey.ipAddress %></span>
                <span><b>Source:</b> <%= journey.sourceLabel %></span>
                <span><b>Last seen:</b> <%= journey.lastSeenDisplay %></span>
                <small><%= journey.landingLabel %> - <%= journey.landingPath %></small>
              </article>
            <% }) %>
            <% if (!audience.knownVisitorRows.length) { %><p class="muted-copy">No known visitors in this window.</p><% } %>
          </div>
        </section>
      </div>
    </details>

    <% audience.sourceBreakdown.forEach((source) => { %>
      <details class="request-manager-card audience-manager-card">
        <summary class="request-manager-summary audience-manager-summary">
          <span class="request-summary-customer"><%= source.label %> Visits</span>
          <span class="request-summary-id"><%= source.count %> visits</span>
          <span class="request-summary-service"><%= source.category %></span>
          <span class="request-summary-payment <%= source.category === 'Paid Ads' ? 'is-unpaid' : 'is-paid' %>"><%= source.category === 'Paid Ads' ? 'Ads' : 'Source' %></span>
          <span class="request-summary-date">Grouped by date</span>
        </summary>
        <div class="request-manager-body audience-manager-body">
          <section class="request-manager-main audience-manager-main">
            <div class="audience-expanded-list">
              <% source.dateGroups.forEach((dateGroup) => { %>
                <h3 class="audience-date-heading"><%= dateGroup.displayDate %></h3>
                <% dateGroup.journeys.forEach((journey) => { %>
                  <details class="audience-expanded-row audience-journey-row">
                    <summary>
                      <strong><%= journey.visitorLabel %></strong>
                      <span><b>IP:</b> <%= journey.ipAddress %></span>
                      <span><b>Landed:</b> <%= journey.landingLabel %></span>
                      <span><b>Last seen:</b> <%= journey.lastSeenDisplay %></span>
                      <small><%= journey.badge %> - <%= journey.landingPath || '-' %></small>
                    </summary>
                    <ol class="journey-timeline audience-row-timeline">
                      <% journey.events.forEach((event) => { %>
                        <li>
                          <span><%= event.displayTime %></span>
                          <strong><%= event.actionLabel %></strong>
                          <small><%= event.serviceName || event.pageLabel %> - <%= event.path || '-' %></small>
                          <small>IP: <%= event.ipLabel %> - Source: <%= event.sourceLabel %></small>
                        </li>
                      <% }) %>
                    </ol>
                  </details>
                <% }) %>
              <% }) %>
              <% if (!source.dateGroups.length) { %>
                <p class="muted-copy">No visits recorded for this source in this window.</p>
              <% } %>
            </div>
          </section>
        </div>
      </details>
    <% }) %>
  </section>

  <section class="dashboard-grid audience-proof-grid">
    <details class="dashboard-panel collapsible-panel">
      <summary class="panel-heading-row">
        <div>
          <p class="eyebrow">Ad / Traffic Proof</p>
          <h2>Where Visitors Came From</h2>
        </div>
        <span class="panel-toggle">Open</span>
      </summary>
      <% if (!audience.sourceBreakdown.length) { %>
        <p class="muted-copy">No source records yet.</p>
      <% } %>
      <div class="source-group-list">
        <% audience.sourceBreakdown.forEach((item) => { %>
          <details class="source-group">
            <summary class="audience-row source-row">
              <div>
                <strong><%= item.label %></strong>
                <small><%= item.category %></small>
              </div>
              <span><%= item.count %></span>
            </summary>
            <div class="source-date-list">
              <% item.dateGroups.forEach((dateGroup) => { %>
                <details class="source-date-group">
                  <summary>
                    <strong><%= dateGroup.displayDate %></strong>
                    <span><%= dateGroup.journeys.length %></span>
                  </summary>
                  <div class="source-journey-list">
                    <% dateGroup.journeys.forEach((journey) => { %>
                      <details class="source-journey">
                        <summary>
                          <div>
                            <strong><%= journey.badge %></strong>
                            <small><%= journey.landingLabel %> - <%= journey.ipAddress %> - <%= journey.lastSeenDisplay %></small>
                          </div>
                          <span>Open</span>
                        </summary>
                        <ol class="journey-timeline">
                          <% journey.events.forEach((event) => { %>
                            <li>
                              <span><%= event.displayTime %></span>
                              <strong><%= event.actionLabel %></strong>
                              <small><%= event.serviceName || event.pageLabel %> - <%= event.path || '-' %></small>
                              <small>IP: <%= event.ipLabel %> - Source: <%= event.sourceLabel %></small>
                            </li>
                          <% }) %>
                        </ol>
                      </details>
                    <% }) %>
                  </div>
                </details>
              <% }) %>
            </div>
          </details>
        <% }) %>
      </div>
    </details>

    <details class="dashboard-panel collapsible-panel">
      <summary class="panel-heading-row">
        <div>
          <p class="eyebrow">First Touch</p>
          <h2>Top Landing Pages</h2>
        </div>
        <span class="panel-toggle">Open</span>
      </summary>
      <% if (!audience.topLandingPages.length) { %>
        <p class="muted-copy">No landing pages recorded yet.</p>
      <% } %>
      <div class="audience-list">
        <% audience.topLandingPages.forEach((item) => { %>
          <div class="audience-row">
            <div>
              <strong><%= item.label %></strong>
              <small><%= item._id %></small>
            </div>
            <span><%= item.count %></span>
          </div>
        <% }) %>
      </div>
    </details>
  </section>
  <details class="dashboard-panel collapsible-panel">
    <summary class="panel-heading-row">
      <div>
        <p class="eyebrow">Clear Visitor Story</p>
        <h2>Recent Visitor Journeys</h2>
      </div>
      <span class="panel-toggle">Open</span>
    </summary>
    <% if (!audience.visitorJourneys.length) { %>
      <p class="muted-copy">No visitor journeys recorded yet.</p>
    <% } %>
    <div class="visitor-journey-list">
      <% audience.visitorJourneys.forEach((journey) => { %>
        <details class="visitor-journey-card <%= journey.badge === 'Owner visit' ? 'is-owner' : '' %>">
          <summary class="journey-summary">
            <div>
              <span class="journey-badge"><%= journey.badge %></span>
              <h3><%= journey.visitorLabel %></h3>
              <p><strong>Source:</strong> <%= journey.sourceLabel %> <span class="muted-inline">(<%= journey.sourceCategory %>)</span></p>
              <p><strong>Landed:</strong> <%= journey.landingLabel %> <span class="muted-inline"><%= journey.landingPath %></span></p>
            </div>
            <div class="journey-meta">
              <p><strong>IP:</strong> <%= journey.ipAddress %></p>
              <p><strong>Area:</strong> <%= journey.locationLabel %></p>
              <p><strong>Device:</strong> <%= journey.deviceLabel %></p>
              <p><strong>Last seen:</strong> <%= journey.lastSeenDisplay %></p>
            </div>
            <span class="journey-toggle">View details</span>
          </summary>
          <div class="journey-details">
            <% if (journey.services.length) { %>
              <div class="journey-services">
                <% journey.services.forEach((serviceName) => { %>
                  <span><%= serviceName %></span>
                <% }) %>
              </div>
            <% } %>
            <ol class="journey-timeline">
              <% journey.events.forEach((event) => { %>
                <li>
                  <span><%= event.displayTime %></span>
                  <strong><%= event.actionLabel %></strong>
                  <small><%= event.serviceName || event.pageLabel %> - <%= event.path || '-' %></small>
                </li>
              <% }) %>
            </ol>
          </div>
        </details>
      <% }) %>
    </div>
  </details>

  <details class="dashboard-panel collapsible-panel">
    <summary class="dashboard-topline panel-heading-row">
      <div>
        <p class="eyebrow">Roadside Service Visitors</p>
        <h2>Visitors By Service</h2>
      </div>
      <span class="panel-toggle">Open</span>
    </summary>
    <div class="service-visitor-grid">
      <% audience.serviceGroups.forEach((group) => { %>
        <article class="service-visitor-card">
          <div class="service-visitor-head">
            <div>
              <span><%= group.label %></span>
              <strong><%= group.count %></strong>
            </div>
          </div>
          <% if (!group.events.length) { %>
            <p class="muted-copy">No visitors recorded for this service yet.</p>
          <% } else { %>
            <div class="service-visitor-list">
              <% group.events.forEach((event) => { %>
                <div class="service-visitor-event">
                  <strong><%= event.actionLabel %></strong>
                  <span><%= event.displayTime %></span>
                  <small><%= event.visitorLabel %> - <%= event.sourceLabel %> - IP: <%= event.ipLabel %></small>
                  <small><%= event.path || '-' %></small>
                </div>
              <% }) %>
            </div>
          <% } %>
        </article>
      <% }) %>
    </div>
  </details>

  <section class="dashboard-grid audience-proof-grid">
    <details class="dashboard-panel collapsible-panel">
      <summary class="panel-heading-row">
        <h2>Top Pages</h2>
        <span class="panel-toggle">Open</span>
      </summary>
      <% if (!audience.topPages.length) { %>
        <p class="muted-copy">No page visits recorded yet.</p>
      <% } %>
      <div class="audience-list">
        <% audience.topPages.forEach((item) => { %>
          <div class="audience-row">
            <div>
              <strong><%= item.label %></strong>
              <small><%= item._id %></small>
            </div>
            <span><%= item.count %></span>
          </div>
        <% }) %>
      </div>
    </details>

    <details class="dashboard-panel collapsible-panel">
      <summary class="panel-heading-row">
        <h2>Recent Raw Activity</h2>
        <span class="panel-toggle">Open</span>
      </summary>
      <div class="compact-activity-list">
        <% audience.recentEvents.forEach((event) => { %>
          <div>
            <strong><%= event.actionLabel %></strong>
            <span><%= event.displayTime %></span>
            <small><%= event.visitorLabel %> - <%= event.sourceLabel %> - <%= event.serviceName || event.pageLabel %> - IP: <%= event.ipLabel %></small>
          </div>
        <% }) %>
      </div>
    </details>
  </section>
</main>
</body>
</html>
