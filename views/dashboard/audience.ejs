<%- include('partials/head') %>
<%- include('partials/nav') %>
<main class="dashboard-main">
  <div class="dashboard-topline audience-hero">
    <div>
      <p class="eyebrow">Website Analytics</p>
      <h1>Visitor Journeys</h1>
      <p class="muted-copy">Showing visits from <%= audienceWindow.label %>. Visits before August 17, 2026 are hidden for now.</p>
    </div>
    <div class="manager-actions small">
      <span class="btn secondary">Aug 17 onward</span>
      <a class="btn secondary" href="/dashboard/audience/export.csv?days=<%= days %>">Download CSV</a>
    </div>
  </div>

  <section class="stat-grid audience-stat-grid">
    <article class="stat-card metric-card"><span>Page Visits</span><strong><%= audience.visits %></strong></article>
    <article class="stat-card metric-card"><span>Real Visitor Visits</span><strong><%= audience.customerVisits %></strong></article>
    <article class="stat-card metric-card"><span>Owner Visits</span><strong><%= audience.ownerVisits %></strong></article>
    <article class="stat-card metric-card"><span>Known Visitors</span><strong><%= audience.uniqueVisitors %></strong></article>
  </section>

  <details class="request-manager-card audience-manager-card google-audit-card" open>
    <summary class="request-manager-summary audience-manager-summary google-audit-summary">
      <span class="request-summary-customer">Google Ads Journey Audit</span>
      <span class="request-summary-id"><%= audience.googleAdsAudit.totals.landings %> landings</span>
      <span class="request-summary-service"><%= audience.googleAdsAudit.totals.uniqueAdClickIds %> unique ad IDs</span>
      <span class="request-summary-payment is-unpaid">Ads</span>
      <span class="request-summary-date">Grouped by visit date</span>
    </summary>
    <div class="request-manager-body audience-manager-body">
      <section class="request-manager-main audience-manager-main">
        <div class="audience-export-row">
          <a class="btn secondary dashboard-action-btn" href="/dashboard/audience/export.csv?days=<%= days %>&type=source&sourceName=Google%20Ads&sourceCategory=Paid%20Ads">Download Google Ads CSV</a>
        </div>
        <div class="google-daily-total-grid">
          <article><span>Google Ads Landings</span><strong><%= audience.googleAdsAudit.totals.landings %></strong></article>
          <article><span>Unique Tracked Visitors</span><strong><%= audience.googleAdsAudit.totals.uniqueVisitors %></strong></article>
          <article><span>Sessions</span><strong><%= audience.googleAdsAudit.totals.sessions %></strong></article>
          <article><span>Page Views</span><strong><%= audience.googleAdsAudit.totals.pageViews %></strong></article>
          <article><span>Unique Ad Click IDs</span><strong><%= audience.googleAdsAudit.totals.uniqueAdClickIds %></strong></article>
          <article><span>Homepage Only</span><strong><%= audience.googleAdsAudit.totals.homepageOnlyVisits %></strong></article>
          <article><span>Service Page Visits</span><strong><%= audience.googleAdsAudit.totals.servicePageVisits %></strong></article>
          <article><span>Engaged Visitors</span><strong><%= audience.googleAdsAudit.totals.engagedVisitors %></strong></article>
          <article><span>Service Starts</span><strong><%= audience.googleAdsAudit.totals.serviceRequestStarts %></strong></article>
          <article><span>Quote Requests</span><strong><%= audience.googleAdsAudit.totals.quoteRequests %></strong></article>
          <article><span>Checkout Reaches</span><strong><%= audience.googleAdsAudit.totals.checkoutReaches %></strong></article>
          <article><span>Completed Bookings</span><strong><%= audience.googleAdsAudit.totals.completedBookings %></strong></article>
          <article><span>Repeat Visitors</span><strong><%= audience.googleAdsAudit.totals.repeatVisitors %></strong></article>
          <article><span>Abandoned Visits</span><strong><%= audience.googleAdsAudit.totals.abandonedVisits %></strong></article>
          <article><span>Abandonment Rate</span><strong><%= audience.googleAdsAudit.totals.abandonmentRate %>%</strong></article>
          <article><span>Owner/Test Clicks</span><strong><%= audience.googleAdsAudit.ownerTotals.landings %></strong></article>
          <article><span>Unknown Ad Visits</span><strong><%= audience.googleAdsAudit.unknownTotals.landings %></strong></article>
        </div>
        <div class="audience-expanded-list">
          <% audience.googleAdsAudit.dateGroups.forEach((dateGroup) => { %>
            <details class="audience-date-group">
              <summary class="audience-date-summary">
                <strong><%= dateGroup.displayDate %></strong>
                <span><%= dateGroup.totals.landings %> external landings · <%= dateGroup.totals.uniqueVisitors %> tracked visitors · <%= dateGroup.ownerVisits %> owner/test · <%= dateGroup.unknownVisits %> unknown · <%= dateGroup.totals.abandonedVisits %> abandoned</span>
              </summary>
              <div class="google-daily-total-grid compact">
                <article><span>Landings</span><strong><%= dateGroup.totals.landings %></strong></article>
                <article><span>Visitors</span><strong><%= dateGroup.totals.uniqueVisitors %></strong></article>
                <article><span>Sessions</span><strong><%= dateGroup.totals.sessions %></strong></article>
                <article><span>Page Views</span><strong><%= dateGroup.totals.pageViews %></strong></article>
                <article><span>Unique IDs</span><strong><%= dateGroup.totals.uniqueAdClickIds %></strong></article>
                <article><span>Homepage Only</span><strong><%= dateGroup.totals.homepageOnlyVisits %></strong></article>
                <article><span>Service Pages</span><strong><%= dateGroup.totals.servicePageVisits %></strong></article>
                <article><span>Engaged</span><strong><%= dateGroup.totals.engagedVisitors %></strong></article>
                <article><span>Service Starts</span><strong><%= dateGroup.totals.serviceRequestStarts %></strong></article>
                <article><span>Quotes</span><strong><%= dateGroup.totals.quoteRequests %></strong></article>
                <article><span>Checkout</span><strong><%= dateGroup.totals.checkoutReaches %></strong></article>
                <article><span>Bookings</span><strong><%= dateGroup.totals.completedBookings %></strong></article>
                <article><span>Repeat</span><strong><%= dateGroup.totals.repeatVisitors %></strong></article>
                <article><span>Abandoned</span><strong><%= dateGroup.totals.abandonedVisits %></strong></article>
                <article><span>Abandonment</span><strong><%= dateGroup.totals.abandonmentRate %>%</strong></article>
                <article><span>Owner/Test</span><strong><%= dateGroup.ownerVisits %></strong></article>
                <article><span>Unknown</span><strong><%= dateGroup.unknownVisits %></strong></article>
              </div>
              <div class="google-journey-list">
                <% dateGroup.journeys.forEach((journey) => { %>
                  <details class="visitor-journey-card google-journey-card <%= journey.trafficIdentity === 'Owner-test' ? 'is-owner' : '' %>">
                    <summary class="journey-summary">
                      <div>
                        <span class="journey-badge"><%= journey.badge %></span>
                        <h3><%= journey.visitorLabel %></h3>
                        <p><strong>Traffic type:</strong> <%= journey.trafficIdentity %></p>
                        <p><strong>Timestamp:</strong> <%= journey.firstSeenDisplay %></p>
                        <p><strong>Landed:</strong> <%= journey.landingLabel %> <span class="muted-inline"><%= journey.landingPath %></span></p>
                      </div>
                      <div class="journey-meta">
                        <p><strong>GCLID:</strong> <%= journey.gclid %></p>
                        <p><strong>GBRAID:</strong> <%= journey.gbraid %></p>
                        <p><strong>WBRAID:</strong> <%= journey.wbraid %></p>
                        <p><strong>Session:</strong> <%= journey.sessionId %></p>
                        <p><strong>Visitor:</strong> <%= journey.visitorId %></p>
                        <p><strong>Page Views:</strong> <%= journey.pageViewCount %></p>
                        <p><strong>Device:</strong> <%= journey.deviceLabel %></p>
                      </div>
                      <span class="journey-toggle">View audit</span>
                    </summary>
                    <div class="journey-details google-journey-details">
                      <div class="google-audit-grid">
                        <p><span>Source / Medium</span><strong><%= journey.sourceLabel %> / <%= journey.sourceMedium %></strong></p>
                        <p><span>UTM Source</span><strong><%= journey.utmSource %></strong></p>
                        <p><span>UTM Campaign</span><strong><%= journey.utmCampaign %></strong></p>
                        <p><span>Campaign ID</span><strong><%= journey.campaignId %></strong></p>
                        <p><span>IP / Area</span><strong><%= journey.ipAddress %> · <%= journey.locationLabel %></strong></p>
                        <p><span>Browser</span><strong><%= journey.browserName %> · <%= journey.operatingSystem %></strong></p>
                        <p><span>Total Page Time</span><strong><%= journey.totalDurationDisplay %></strong></p>
                        <p><span>Request Service Opened</span><strong><%= journey.requestOpened ? 'Yes' : 'No' %></strong></p>
                        <p><span>Form Started</span><strong><%= journey.formStarted ? 'Yes' : 'No' %></strong></p>
                        <p><span>Quote Requested</span><strong><%= journey.quoteRequested ? 'Yes' : 'No' %></strong></p>
                        <p><span>Checkout Reached</span><strong><%= journey.checkoutReached ? 'Yes' : 'No' %></strong></p>
                        <p><span>Exited Without Action</span><strong><%= journey.exitedWithoutAction ? 'Yes' : 'No' %></strong></p>
                      </div>
                      <div>
                        <h4>Original Raw Landing URL</h4>
                        <p class="muted-copy"><%= journey.originalRawLandingUrl %></p>
                      </div>
                      <div>
                        <h4>Pages Viewed In Order</h4>
                        <ol class="journey-timeline google-timeline">
                          <% journey.pagesViewed.forEach((page) => { %>
                            <li>
                              <span><%= page.time %></span>
                              <strong><%= page.label %></strong>
                              <small><%= page.path || '-' %></small>
                              <small>Time on page: <%= page.durationDisplay %></small>
                            </li>
                          <% }) %>
                        </ol>
                        <% if (!journey.pagesViewed.length) { %><p class="muted-copy">No page views stored for this journey.</p><% } %>
                      </div>
                      <div>
                        <h4>Buttons Clicked</h4>
                        <ol class="journey-timeline google-timeline">
                          <% journey.buttonsClicked.forEach((event) => { %>
                            <li>
                              <span><%= event.displayTime %></span>
                              <strong><%= event.buttonLabel %></strong>
                              <small><%= event.buttonHref || event.path || '-' %></small>
                            </li>
                          <% }) %>
                        </ol>
                        <% if (!journey.buttonsClicked.length) { %><p class="muted-copy">No button clicks stored for this journey.</p><% } %>
                      </div>
                      <div>
                        <h4>Complete Event Path</h4>
                        <ol class="journey-timeline google-timeline">
                          <% journey.events.forEach((event) => { %>
                            <li>
                              <span><%= event.displayTime %></span>
                              <strong><%= event.actionLabel %></strong>
                              <small><%= event.serviceName || event.pageLabel %> - <%= event.path || '-' %></small>
                              <% if (event.eventType === 'button_click') { %><small>Button: <%= event.buttonLabel %></small><% } %>
                              <% if (event.eventType === 'page_duration') { %><small>Time spent: <%= event.durationDisplay %></small><% } %>
                            </li>
                          <% }) %>
                        </ol>
                      </div>
                    </div>
                  </details>
                <% }) %>
              </div>
            </details>
          <% }) %>
          <% if (!audience.googleAdsAudit.journeys.length) { %>
            <p class="muted-copy">No Google Ads journeys are recorded in this window.</p>
          <% } %>
        </div>
      </section>
    </div>
  </details>

  <section class="request-manager-list audience-manager-list" aria-label="Visitor visit breakdown">
    <details class="request-manager-card audience-manager-card">
      <summary class="request-manager-summary audience-manager-summary">
        <span class="request-summary-customer">Page Visits</span>
        <span class="request-summary-id"><%= audience.visits %> visits</span>
        <span class="request-summary-service">All pages</span>
        <span class="request-summary-payment is-paid">Tracked</span>
        <span class="request-summary-date">All page views</span>
      </summary>
      <div class="request-manager-body audience-manager-body">
        <section class="request-manager-main audience-manager-main">
          <div class="audience-export-row">
            <a class="btn secondary dashboard-action-btn" href="/dashboard/audience/export.csv?days=<%= days %>&type=page">Download Page Visits CSV</a>
          </div>
          <div class="audience-expanded-list">
            <% audience.pageVisitDateGroups.forEach((dateGroup) => { %>
              <details class="audience-date-group">
                <summary class="audience-date-summary">
                  <strong><%= dateGroup.displayDate %></strong>
                  <span><%= dateGroup.events.length %> visits</span>
                </summary>
                <div class="audience-date-body">
                  <% dateGroup.events.forEach((event) => { %>
                    <article class="audience-expanded-row">
                      <strong><%= event.pageLabel %></strong>
                      <span><b>IP:</b> <%= event.ipLabel %></span>
                      <span><b>Location:</b> <%= event.locationLabel %></span>
                      <span><b>Source:</b> <%= event.sourceLabel %></span>
                      <span><b>Time:</b> <%= event.displayTime %></span>
                      <small><%= event.path || '-' %> - <%= event.ispLabel %></small>
                    </article>
                  <% }) %>
                </div>
              </details>
            <% }) %>
            <% if (!audience.pageVisitEvents.length) { %><p class="muted-copy">No page visits in this window.</p><% } %>
          </div>
        </section>
      </div>
    </details>

    <details class="request-manager-card audience-manager-card">
      <summary class="request-manager-summary audience-manager-summary">
        <span class="request-summary-customer">Real Visitor Visits</span>
        <span class="request-summary-id"><%= audience.customerVisits %> visits</span>
        <span class="request-summary-service">Not owner</span>
        <span class="request-summary-payment is-paid">Visitors</span>
        <span class="request-summary-date">All visitor page views</span>
      </summary>
      <div class="request-manager-body audience-manager-body">
        <section class="request-manager-main audience-manager-main">
          <div class="audience-export-row">
            <a class="btn secondary dashboard-action-btn" href="/dashboard/audience/export.csv?days=<%= days %>&type=real">Download Real Visitor CSV</a>
          </div>
          <div class="audience-expanded-list">
            <% audience.customerVisitDateGroups.forEach((dateGroup) => { %>
              <details class="audience-date-group">
                <summary class="audience-date-summary">
                  <strong><%= dateGroup.displayDate %></strong>
                  <span><%= dateGroup.events.length %> visits</span>
                </summary>
                <div class="audience-date-body">
                  <% dateGroup.events.forEach((event) => { %>
                    <article class="audience-expanded-row">
                      <strong><%= event.pageLabel %></strong>
                      <span><b>IP:</b> <%= event.ipLabel %></span>
                      <span><b>Location:</b> <%= event.locationLabel %></span>
                      <span><b>Source:</b> <%= event.sourceLabel %></span>
                      <span><b>Time:</b> <%= event.displayTime %></span>
                      <small><%= event.path || '-' %> - <%= event.ispLabel %></small>
                    </article>
                  <% }) %>
                </div>
              </details>
            <% }) %>
            <% if (!audience.customerVisitEvents.length) { %><p class="muted-copy">No real visitor visits in this window.</p><% } %>
          </div>
        </section>
      </div>
    </details>

    <details class="request-manager-card audience-manager-card">
      <summary class="request-manager-summary audience-manager-summary">
        <span class="request-summary-customer">Owner Visits</span>
        <span class="request-summary-id"><%= audience.ownerVisits %> visits</span>
        <span class="request-summary-service">Your checks</span>
        <span class="request-summary-payment is-unpaid">Owner</span>
        <span class="request-summary-date">Matched owner IP/session</span>
      </summary>
      <div class="request-manager-body audience-manager-body">
        <section class="request-manager-main audience-manager-main">
          <div class="audience-export-row">
            <a class="btn secondary dashboard-action-btn" href="/dashboard/audience/export.csv?days=<%= days %>&type=owner">Download Owner Visits CSV</a>
          </div>
          <div class="audience-expanded-list">
            <% audience.ownerVisitDateGroups.forEach((dateGroup) => { %>
              <details class="audience-date-group">
                <summary class="audience-date-summary">
                  <strong><%= dateGroup.displayDate %></strong>
                  <span><%= dateGroup.events.length %> visits</span>
                </summary>
                <div class="audience-date-body">
                  <% dateGroup.events.forEach((event) => { %>
                    <article class="audience-expanded-row">
                      <strong><%= event.pageLabel %></strong>
                      <span><b>IP:</b> <%= event.ipLabel %></span>
                      <span><b>Location:</b> <%= event.locationLabel %></span>
                      <span><b>Source:</b> <%= event.sourceLabel %></span>
                      <span><b>Time:</b> <%= event.displayTime %></span>
                      <small><%= event.path || '-' %> - <%= event.ispLabel %></small>
                    </article>
                  <% }) %>
                </div>
              </details>
            <% }) %>
            <% if (!audience.ownerVisitEvents.length) { %><p class="muted-copy">No owner visits in this window.</p><% } %>
          </div>
        </section>
      </div>
    </details>

    <details class="request-manager-card audience-manager-card">
      <summary class="request-manager-summary audience-manager-summary">
        <span class="request-summary-customer">Known Visitors</span>
        <span class="request-summary-id"><%= audience.uniqueVisitors %> visitors</span>
        <span class="request-summary-service">Grouped journeys</span>
        <span class="request-summary-payment is-paid">Sessions</span>
        <span class="request-summary-date">All visitor groups</span>
      </summary>
      <div class="request-manager-body audience-manager-body">
        <section class="request-manager-main audience-manager-main">
          <div class="audience-export-row">
            <a class="btn secondary dashboard-action-btn" href="/dashboard/audience/export.csv?days=<%= days %>&type=known">Download Known Visitors CSV</a>
          </div>
          <div class="audience-expanded-list">
            <% audience.knownVisitorDateGroups.forEach((dateGroup) => { %>
              <details class="audience-date-group">
                <summary class="audience-date-summary">
                  <strong><%= dateGroup.displayDate %></strong>
                  <span><%= dateGroup.journeys.length %> visitors</span>
                </summary>
                <div class="audience-date-body">
                  <% dateGroup.journeys.forEach((journey) => { %>
                    <article class="audience-expanded-row">
                      <strong><%= journey.visitorLabel %></strong>
                      <span><b>IP:</b> <%= journey.ipAddress %></span>
                      <span><b>Location:</b> <%= journey.locationLabel %></span>
                      <span><b>Source:</b> <%= journey.sourceLabel %></span>
                      <span><b>Last seen:</b> <%= journey.lastSeenDisplay %></span>
                      <small><%= journey.landingLabel %> - <%= journey.landingPath %> - <%= journey.ispLabel %></small>
                    </article>
                  <% }) %>
                </div>
              </details>
            <% }) %>
            <% if (!audience.knownVisitorRows.length) { %><p class="muted-copy">No known visitors in this window.</p><% } %>
          </div>
        </section>
      </div>
    </details>

    <% audience.sourceBreakdown.forEach((source) => { %>
      <details class="request-manager-card audience-manager-card">
        <summary class="request-manager-summary audience-manager-summary">
          <span class="request-summary-customer"><%= source.label %> Visits</span>
          <span class="request-summary-id"><%= source.count %> visits</span>
          <span class="request-summary-service"><%= source.category %></span>
          <span class="request-summary-payment <%= source.category === 'Paid Ads' ? 'is-unpaid' : 'is-paid' %>"><%= source.category === 'Paid Ads' ? 'Ads' : 'Source' %></span>
          <span class="request-summary-date">Grouped by date</span>
        </summary>
        <div class="request-manager-body audience-manager-body">
          <section class="request-manager-main audience-manager-main">
            <div class="audience-export-row">
              <a class="btn secondary dashboard-action-btn" href="/dashboard/audience/export.csv?days=<%= days %>&type=source&sourceName=<%= encodeURIComponent(source.label) %>&sourceCategory=<%= encodeURIComponent(source.category) %>">Download <%= source.label %> CSV</a>
            </div>
            <div class="audience-expanded-list">
              <% source.dateGroups.forEach((dateGroup) => { %>
                <details class="audience-date-group">
                  <summary class="audience-date-summary">
                    <strong><%= dateGroup.displayDate %></strong>
                    <span><%= dateGroup.journeys.length %> visits</span>
                  </summary>
                  <div class="audience-date-body">
                    <% dateGroup.journeys.forEach((journey) => { %>
                      <details class="audience-expanded-row audience-journey-row">
                        <summary>
                          <strong><%= journey.visitorLabel %></strong>
                          <span><b>IP:</b> <%= journey.ipAddress %></span>
                          <span><b>Location:</b> <%= journey.locationLabel %></span>
                          <span><b>Landed:</b> <%= journey.landingLabel %></span>
                          <span><b>Last seen:</b> <%= journey.lastSeenDisplay %></span>
                          <small><%= journey.badge %> - <%= journey.landingPath || '-' %> - <%= journey.ispLabel %></small>
                        </summary>
                        <ol class="journey-timeline audience-row-timeline">
                          <% journey.events.forEach((event) => { %>
                            <li>
                              <span><%= event.displayTime %></span>
                              <strong><%= event.actionLabel %></strong>
                              <small><%= event.serviceName || event.pageLabel %> - <%= event.path || '-' %></small>
                              <small>IP: <%= event.ipLabel %> - Location: <%= event.locationLabel %> - Source: <%= event.sourceLabel %></small>
                            </li>
                          <% }) %>
                        </ol>
                      </details>
                    <% }) %>
                  </div>
                </details>
              <% }) %>
              <% if (!source.dateGroups.length) { %>
                <p class="muted-copy">No visits recorded for this source in this window.</p>
              <% } %>
            </div>
          </section>
        </div>
      </details>
    <% }) %>
  </section>

  <section class="dashboard-grid audience-proof-grid">
    <details class="dashboard-panel collapsible-panel">
      <summary class="panel-heading-row">
        <div>
          <p class="eyebrow">Ad / Traffic Proof</p>
          <h2>Where Visitors Came From</h2>
        </div>
        <span class="panel-toggle">Open</span>
      </summary>
      <% if (!audience.sourceBreakdown.length) { %>
        <p class="muted-copy">No source records yet.</p>
      <% } %>
      <div class="source-group-list">
        <% audience.sourceBreakdown.forEach((item) => { %>
          <details class="source-group">
            <summary class="audience-row source-row">
              <div>
                <strong><%= item.label %></strong>
                <small><%= item.category %></small>
              </div>
              <span><%= item.count %></span>
            </summary>
            <div class="source-date-list">
              <% item.dateGroups.forEach((dateGroup) => { %>
                <details class="source-date-group">
                  <summary>
                    <strong><%= dateGroup.displayDate %></strong>
                    <span><%= dateGroup.journeys.length %></span>
                  </summary>
                  <div class="source-journey-list">
                    <% dateGroup.journeys.forEach((journey) => { %>
                      <details class="source-journey">
                        <summary>
                          <div>
                            <strong><%= journey.badge %></strong>
                            <small><%= journey.landingLabel %> - <%= journey.ipAddress %> - <%= journey.lastSeenDisplay %></small>
                          </div>
                          <span>Open</span>
                        </summary>
                        <ol class="journey-timeline">
                          <% journey.events.forEach((event) => { %>
                            <li>
                              <span><%= event.displayTime %></span>
                              <strong><%= event.actionLabel %></strong>
                              <small><%= event.serviceName || event.pageLabel %> - <%= event.path || '-' %></small>
                              <small>IP: <%= event.ipLabel %> - Location: <%= event.locationLabel %> - Source: <%= event.sourceLabel %></small>
                            </li>
                          <% }) %>
                        </ol>
                      </details>
                    <% }) %>
                  </div>
                </details>
              <% }) %>
            </div>
          </details>
        <% }) %>
      </div>
    </details>

    <details class="dashboard-panel collapsible-panel">
      <summary class="panel-heading-row">
        <div>
          <p class="eyebrow">First Touch</p>
          <h2>Top Landing Pages</h2>
        </div>
        <span class="panel-toggle">Open</span>
      </summary>
      <% if (!audience.topLandingPages.length) { %>
        <p class="muted-copy">No landing pages recorded yet.</p>
      <% } %>
      <div class="audience-list">
        <% audience.topLandingPages.forEach((item) => { %>
          <div class="audience-row">
            <div>
              <strong><%= item.label %></strong>
              <small><%= item._id %></small>
            </div>
            <span><%= item.count %></span>
          </div>
        <% }) %>
      </div>
    </details>
  </section>
  <details class="dashboard-panel collapsible-panel">
    <summary class="panel-heading-row">
      <div>
        <p class="eyebrow">Clear Visitor Story</p>
        <h2>Recent Visitor Journeys</h2>
      </div>
      <span class="panel-toggle">Open</span>
    </summary>
    <% if (!audience.visitorJourneys.length) { %>
      <p class="muted-copy">No visitor journeys recorded yet.</p>
    <% } %>
    <div class="visitor-journey-list">
      <% audience.visitorJourneys.forEach((journey) => { %>
        <details class="visitor-journey-card <%= journey.trafficIdentity === 'Owner-test' ? 'is-owner' : '' %>">
          <summary class="journey-summary">
            <div>
              <span class="journey-badge"><%= journey.badge %></span>
              <h3><%= journey.visitorLabel %></h3>
              <p><strong>Source:</strong> <%= journey.sourceLabel %> <span class="muted-inline">(<%= journey.sourceCategory %>)</span></p>
              <p><strong>Traffic type:</strong> <%= journey.trafficIdentity %></p>
              <p><strong>Landed:</strong> <%= journey.landingLabel %> <span class="muted-inline"><%= journey.landingPath %></span></p>
            </div>
            <div class="journey-meta">
              <p><strong>IP:</strong> <%= journey.ipAddress %></p>
              <p><strong>Area:</strong> <%= journey.locationLabel %></p>
              <p><strong>Device:</strong> <%= journey.deviceLabel %></p>
              <p><strong>Last seen:</strong> <%= journey.lastSeenDisplay %></p>
            </div>
            <span class="journey-toggle">View details</span>
          </summary>
          <div class="journey-details">
            <% if (journey.services.length) { %>
              <div class="journey-services">
                <% journey.services.forEach((serviceName) => { %>
                  <span><%= serviceName %></span>
                <% }) %>
              </div>
            <% } %>
            <ol class="journey-timeline">
              <% journey.events.forEach((event) => { %>
                <li>
                  <span><%= event.displayTime %></span>
                  <strong><%= event.actionLabel %></strong>
                  <small><%= event.serviceName || event.pageLabel %> - <%= event.path || '-' %></small>
                </li>
              <% }) %>
            </ol>
          </div>
        </details>
      <% }) %>
    </div>
  </details>

  <details class="dashboard-panel collapsible-panel">
    <summary class="dashboard-topline panel-heading-row">
      <div>
        <p class="eyebrow">Roadside Service Visitors</p>
        <h2>Visitors By Service</h2>
      </div>
      <span class="panel-toggle">Open</span>
    </summary>
    <div class="service-visitor-grid">
      <% audience.serviceGroups.forEach((group) => { %>
        <article class="service-visitor-card">
          <div class="service-visitor-head">
            <div>
              <span><%= group.label %></span>
              <strong><%= group.count %></strong>
            </div>
          </div>
          <% if (!group.events.length) { %>
            <p class="muted-copy">No visitors recorded for this service yet.</p>
          <% } else { %>
            <div class="service-visitor-list">
              <% group.events.forEach((event) => { %>
                <div class="service-visitor-event">
                  <strong><%= event.actionLabel %></strong>
                  <span><%= event.displayTime %></span>
                  <small><%= event.visitorLabel %> - <%= event.sourceLabel %> - IP: <%= event.ipLabel %> - Location: <%= event.locationLabel %></small>
                  <small><%= event.path || '-' %></small>
                </div>
              <% }) %>
            </div>
          <% } %>
        </article>
      <% }) %>
    </div>
  </details>

  <section class="dashboard-grid audience-proof-grid">
    <details class="dashboard-panel collapsible-panel">
      <summary class="panel-heading-row">
        <h2>Top Pages</h2>
        <span class="panel-toggle">Open</span>
      </summary>
      <% if (!audience.topPages.length) { %>
        <p class="muted-copy">No page visits recorded yet.</p>
      <% } %>
      <div class="audience-list">
        <% audience.topPages.forEach((item) => { %>
          <div class="audience-row">
            <div>
              <strong><%= item.label %></strong>
              <small><%= item._id %></small>
            </div>
            <span><%= item.count %></span>
          </div>
        <% }) %>
      </div>
    </details>

    <details class="dashboard-panel collapsible-panel">
      <summary class="panel-heading-row">
        <h2>Recent Raw Activity</h2>
        <span class="panel-toggle">Open</span>
      </summary>
      <div class="compact-activity-list">
        <% audience.recentEvents.forEach((event) => { %>
          <div>
            <strong><%= event.actionLabel %></strong>
            <span><%= event.displayTime %></span>
            <small><%= event.visitorLabel %> - <%= event.sourceLabel %> - <%= event.serviceName || event.pageLabel %> - IP: <%= event.ipLabel %> - Location: <%= event.locationLabel %></small>
          </div>
        <% }) %>
      </div>
    </details>
  </section>
</main>
</body>
</html>
