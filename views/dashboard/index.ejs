<%- include('partials/head') %>
<%- include('partials/nav') %>
<main class="dashboard-main">
  <h1>Dashboard Overview</h1>
  <div class="stat-grid">
    <a class="stat-card" href="/dashboard/requests">
      <span>All Requests</span>
      <strong><%= Object.values(statusCounts).reduce((total, count) => total + count, 0) %></strong>
    </a>
    <a class="stat-card" href="/dashboard/requests?payment=unpaid">
      <span>Unpaid Requests</span>
      <strong><%= Object.entries(paymentStatusCounts).filter(([status]) => status !== 'Paid').reduce((total, [, count]) => total + count, 0) %></strong>
    </a>
    <a class="stat-card" href="/dashboard/requests?payment=paid">
      <span>Paid Requests</span>
      <strong><%= paymentStatusCounts.Paid || 0 %></strong>
    </a>
    <a class="stat-card" href="/dashboard/requests?status=Completed">
      <span>Completed Jobs</span>
      <strong><%= statusCounts.Completed || 0 %></strong>
    </a>
  </div>
  <section class="dashboard-panel audience-summary-panel">
    <div class="dashboard-topline">
      <div>
        <p class="eyebrow">Last 7 Days</p>
        <h2>Website Audience</h2>
      </div>
      <a class="btn secondary" href="/dashboard/audience">View Audience</a>
    </div>
    <div class="audience-summary-grid">
      <div>
        <span>Page visits</span>
        <strong><%= audience.visits %></strong>
      </div>
      <div>
        <span>Known visitors</span>
        <strong><%= audience.uniqueVisitors %></strong>
      </div>
      <div>
        <span>Most viewed service</span>
        <strong><%= audience.topServices[0]?._id || 'None yet' %></strong>
      </div>
    </div>
  </section>
  <section class="dashboard-panel">
    <h2>Recent Requests</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Customer</th><th>Problem</th><th>Location</th><th>Status</th><th>Created</th></tr></thead>
        <tbody>
          <% recentRequests.forEach((item) => { %>
            <tr><td><%= item.customerName %></td><td><%= item.problem %></td><td><%= item.currentLocation %></td><td><%= item.status %></td><td><%= item.createdAt.toLocaleString() %></td></tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</main>
</body>
</html>
