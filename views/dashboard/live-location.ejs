<%- include('partials/head') %>
<%- include('partials/nav') %>
<%
  const activeLocation = technicianLocation?.location?.lat ? technicianLocation.location : businessSettings?.liveTechnicianLocation;
  const isOnline = Boolean(technicianLocation?.online);
  const isAcceptingJobs = acceptingJobs !== false;
%>
<main class="dashboard-main">
  <div class="dashboard-topline">
    <h1>Live Location</h1>
    <a class="btn secondary" href="/dashboard/requests">Requests</a>
  </div>

  <section class="dashboard-panel live-location-panel" data-live-location-panel data-live-location-initial-online="<%= isOnline ? 'true' : 'false' %>" data-live-location-initial-accepting="<%= isAcceptingJobs ? 'true' : 'false' %>">
    <div>
      <p class="eyebrow">Technician location</p>
      <h2>Go Online For Live ETA</h2>
      <p class="muted-copy">Open this page on the device you are carrying. When you go online, your browser sends your current GPS location to the server so customer quotes can use the latest technician location for distance, ETA, and travel pricing.</p>
    </div>

    <div class="live-location-status">
      <p><span>Online status</span><strong data-live-location-online><%= isOnline ? 'Online' : 'Offline' %></strong></p>
      <p><span>Current live location</span><strong data-live-location-current><%= activeLocation?.lat ? `${activeLocation.lat.toFixed(5)}, ${activeLocation.lng.toFixed(5)}` : 'Not sharing yet' %></strong></p>
      <p><span>Last updated</span><strong data-live-location-updated><%= activeLocation?.updatedAt ? new Date(activeLocation.updatedAt).toLocaleString() : 'Not updated yet' %></strong></p>
      <p><span>Job requests</span><strong data-live-location-accepting><%= isAcceptingJobs ? 'Accepting jobs' : 'Not accepting jobs' %></strong></p>
      <p><span>System message</span><strong data-live-location-status><%= isOnline ? 'Live ETA is active.' : 'Go online when you are available.' %></strong></p>
    </div>

    <div class="live-location-actions">
      <button class="btn primary" type="button" data-live-location-start>Go Online</button>
      <button class="btn ghost" type="button" data-live-location-stop>Go Offline</button>
      <button class="btn secondary" type="button" data-accept-jobs>Accept Jobs</button>
      <button class="btn ghost" type="button" data-stop-accepting-jobs>Do Not Accept Jobs</button>
    </div>
  </section>
</main>
</body>
</html>
