<%- include('partials/head') %><%- include('partials/nav') %>
<main class="dashboard-main">
  <h1>Business Settings</h1>
  <section class="dashboard-panel">
    <h2>Owner SMS Alerts</h2>
    <% if (typeof smsStatus !== 'undefined') { %>
      <p class="muted-copy">
        Twilio:
        <strong><%= smsStatus.configured ? 'Configured' : 'Not fully configured' %></strong>
        | From number:
        <strong><%= smsStatus.fromNumber || 'Missing' %></strong>
        | Messaging service:
        <strong><%= smsStatus.hasMessagingServiceSid ? 'Set in Render' : 'Missing' %></strong>
        | Owner number:
        <strong><%= smsStatus.hasToNumber ? 'Set in Render' : 'Using dashboard business/text number' %></strong>
      </p>
    <% } %>
    <% if (typeof reqQuery !== 'undefined' && reqQuery.smsMessage) { %>
      <p class="muted-copy"><strong><%= reqQuery.smsMessage %></strong></p>
    <% } %>
    <% if (typeof csrfToken !== 'undefined') { %>
      <form action="/dashboard/settings/test-sms" method="post" class="mini-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn primary" type="submit">Send Test SMS</button>
      </form>
    <% } %>
  </section>
  <section class="dashboard-panel push-settings-panel" data-push-panel data-csrf="<%= csrfToken %>">
    <div class="dashboard-topline">
      <div>
        <p class="eyebrow">Owner Phone Alerts</p>
        <h2>Booking Push Notifications</h2>
      </div>
      <span class="status-pill" data-push-state>Checking</span>
    </div>
    <div class="push-status-grid">
      <p><span>Browser</span><strong data-push-support>Checking</strong></p>
      <p><span>Permission</span><strong data-push-permission>Checking</strong></p>
      <p><span>Subscribed devices</span><strong data-push-count>0</strong></p>
    </div>
    <p class="muted-copy" data-push-message>Checking notification support on this device.</p>
    <div class="dashboard-actions">
      <button class="btn primary" type="button" data-enable-push>Enable Phone Alerts</button>
      <button class="btn secondary" type="button" data-disable-push disabled>Disable This Device</button>
    </div>
  </section>
  <section class="dashboard-panel">
    <h2>Technician Starting Location</h2>
    <p class="muted-copy">Set where you are starting from now. Quotes use this location against the customer's address or GPS location.</p>
    <p class="muted-copy">For live quote estimates, open <a href="/dashboard/live-location">Live Location</a> on your phone and start sharing while you are available.</p>
    <div class="dispatch-location-tool">
      <button class="btn primary" type="button" data-set-dispatch-location>Use My Current Location as Starting Point</button>
      <strong data-dispatch-location-status>Starting point not set</strong>
    </div>
  </section>
  <section class="dashboard-panel">
    <form class="settings-form" action="/dashboard/settings" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Business Name<input name="businessName" value="<%= businessSettings?.businessName || settings.businessName %>"></label>
      <label>Phone Number<input name="phoneNumber" value="<%= businessSettings?.phoneNumber || settings.phoneNumber %>"></label>
      <label>Text Number<input name="textNumber" value="<%= businessSettings?.textNumber || settings.textNumber %>"></label>
      <label>Email<input name="email" value="<%= businessSettings?.email || settings.email %>"></label>
      <label>Business Hours<input name="businessHours" value="<%= businessSettings?.businessHours || settings.businessHours %>"></label>
      <label>Service Area<input name="serviceArea" value="<%= businessSettings?.serviceArea || settings.serviceArea %>"></label>
      <label>Dispatch Latitude<input name="dispatchLat" value="<%= businessSettings?.dispatchLocation?.lat || settings.dispatchLocation?.lat || '' %>" data-dispatch-lat></label>
      <label>Dispatch Longitude<input name="dispatchLng" value="<%= businessSettings?.dispatchLocation?.lng || settings.dispatchLocation?.lng || '' %>" data-dispatch-lng></label>
      <label>Standard Price Up To Minutes<input name="standardTravelTimeMaxMinutes" type="number" min="1" step="1" value="<%= businessSettings?.quoteConfig?.standardTravelTimeMaxMinutes ?? settings.quoteConfig?.standardTravelTimeMaxMinutes ?? businessSettings?.quoteConfig?.maxTravelTimeMinutes ?? settings.quoteConfig?.maxTravelTimeMinutes ?? 60 %>"></label>
      <label>Tier 1 Max Travel Minutes<input name="tierOneTravelTimeMaxMinutes" type="number" min="1" step="1" value="<%= businessSettings?.quoteConfig?.tierOneTravelTimeMaxMinutes ?? settings.quoteConfig?.tierOneTravelTimeMaxMinutes ?? 90 %>"></label>
      <label>Tier 1 Travel Fee Percent<input name="tierOneTravelFeePercent" type="number" min="0" step="1" value="<%= businessSettings?.quoteConfig?.tierOneTravelFeePercent ?? settings.quoteConfig?.tierOneTravelFeePercent ?? 50 %>"></label>
      <label>Tier 2 Max Travel Minutes<input name="tierTwoTravelTimeMaxMinutes" type="number" min="1" step="1" value="<%= businessSettings?.quoteConfig?.tierTwoTravelTimeMaxMinutes ?? settings.quoteConfig?.tierTwoTravelTimeMaxMinutes ?? 120 %>"></label>
      <label>Tier 2 Travel Fee Percent<input name="tierTwoTravelFeePercent" type="number" min="0" step="1" value="<%= businessSettings?.quoteConfig?.tierTwoTravelFeePercent ?? settings.quoteConfig?.tierTwoTravelFeePercent ?? 100 %>"></label>
      <input name="maxTravelTimeMinutes" type="hidden" value="<%= businessSettings?.quoteConfig?.standardTravelTimeMaxMinutes ?? settings.quoteConfig?.standardTravelTimeMaxMinutes ?? businessSettings?.quoteConfig?.maxTravelTimeMinutes ?? settings.quoteConfig?.maxTravelTimeMinutes ?? 60 %>">
      <input name="longDistanceFee" type="hidden" value="<%= businessSettings?.quoteConfig?.longDistanceFee || settings.quoteConfig?.longDistanceFee || 50 %>">
      <input name="includedMiles" type="hidden" value="<%= businessSettings?.quoteConfig?.includedMiles || settings.quoteConfig?.includedMiles || 10 %>">
      <input name="travelFeePerExtraMile" type="hidden" value="<%= businessSettings?.quoteConfig?.travelFeePerExtraMile || settings.quoteConfig?.travelFeePerExtraMile || 2 %>">
      <label>Google Map Embed URL<input name="googleMapsEmbedUrl" value="<%= businessSettings?.googleMapsEmbedUrl || '' %>"></label>
      <label>Google Review Link<input name="googleReviewUrl" value="<%= businessSettings?.googleReviewUrl || '' %>"></label>
      <label>Meta Title<input name="metaTitle" value="<%= businessSettings?.seo?.metaTitle || '' %>"></label>
      <label>Meta Description<input name="metaDescription" value="<%= businessSettings?.seo?.metaDescription || '' %>"></label>
      <label>Keywords<input name="keywords" value="<%= (businessSettings?.seo?.keywords || []).join(', ') %>"></label>
      <div class="checkbox-row">
        <% ['card','applePay','googlePay','cash','cashApp','zelle'].forEach((method) => { %>
          <label><input type="checkbox" name="<%= method %>" <%= settings.paymentMethods?.[method] ? 'checked' : '' %>> <%= method %></label>
        <% }) %>
      </div>
      <button class="btn primary" type="submit">Save Settings</button>
    </form>
  </section>
  <section class="dashboard-grid">
    <div class="dashboard-panel" id="reviews">
      <h2>Reviews</h2>
      <form action="/dashboard/reviews" method="post" class="mini-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input name="customerName" placeholder="Customer name" required>
        <input name="rating" type="number" min="1" max="5" value="5">
        <textarea name="quote" placeholder="Review" required></textarea>
        <input name="source" placeholder="Source" value="Google">
        <button type="submit">Add Review</button>
      </form>
      <% reviews.forEach((review) => { %><p><strong><%= review.customerName %>:</strong> <%= review.quote %></p><% }) %>
    </div>
    <div class="dashboard-panel" id="photos">
      <h2>Photos</h2>
      <form action="/dashboard/photos" method="post" enctype="multipart/form-data" class="mini-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input name="title" placeholder="Title" required>
        <input type="file" name="photo" accept="image/*">
        <input name="url" placeholder="Cloudinary URL or image path">
        <input name="alt" placeholder="Alt text">
        <button type="submit">Add Photo</button>
      </form>
      <% photos.forEach((photo) => { %><p><%= photo.title %> - <%= photo.url %></p><% }) %>
    </div>
    <div class="dashboard-panel" id="pricing">
      <h2>Pricing</h2>
      <form action="/dashboard/pricing" method="post" class="mini-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input name="serviceName" placeholder="Service" required>
        <input name="startingPrice" type="number" step="0.01" placeholder="Starting price" required>
        <input name="description" placeholder="Description">
        <button type="submit">Add Price</button>
      </form>
      <% pricing.forEach((price) => { %><p><%= price.serviceName %>: $<%= price.startingPrice %></p><% }) %>
    </div>
    <div class="dashboard-panel" id="areas">
      <h2>Service Areas</h2>
      <form action="/dashboard/service-areas" method="post" class="mini-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input name="name" placeholder="Area name" required>
        <input name="priority" type="number" value="0">
        <button type="submit">Add Area</button>
      </form>
      <% areas.forEach((area) => { %><p><%= area.name %></p><% }) %>
    </div>
  </section>
</main>
<script src="/js/dashboard-push.js?v=booking-push-20260822" defer></script>
</body></html>
