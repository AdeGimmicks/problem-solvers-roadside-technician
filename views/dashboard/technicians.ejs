<%- include('partials/head') %>
<%- include('partials/nav') %>
<main class="dashboard-main">
  <div class="dashboard-topline">
    <div>
      <h1><%= currentStatus || 'Technician Applications' %></h1>
      <p class="muted-note">Review technician signups, tools, services, and payout readiness.</p>
    </div>
    <div class="dashboard-topline-actions">
      <a class="btn secondary" href="/technicians/apply" target="_blank" rel="noreferrer">Application Link</a>
      <a class="btn secondary" href="/technician/signup" target="_blank" rel="noreferrer">Portal Signup</a>
      <a class="btn secondary" href="/technician/login" target="_blank" rel="noreferrer">Portal Login</a>
    </div>
  </div>

  <section class="dashboard-panel technician-location-panel">
    <h2>Technician Live Locations</h2>
    <% if (!locations.length) { %>
      <p>No technician live locations yet.</p>
    <% } %>
    <div class="request-metric-row">
      <% locations.forEach((location) => { %>
        <p>
          <span><%= location.label || 'Technician' %></span>
          <strong><%= location.online ? 'Online' : 'Offline' %></strong>
          <small><%= location.location?.lat ? `${location.location.lat.toFixed(5)}, ${location.location.lng.toFixed(5)}` : 'No GPS yet' %></small>
          <small><%= location.location?.updatedAt ? new Date(location.location.updatedAt).toLocaleString() : '' %></small>
        </p>
      <% }) %>
    </div>
  </section>

  <section class="dashboard-panel technician-location-panel">
    <h2>Technician Portal Accounts</h2>
    <% if (!technicianAccounts.length) { %>
      <p>No technician portal accounts yet.</p>
    <% } %>
    <div class="request-metric-row">
      <% technicianAccounts.forEach((account) => { %>
        <p>
          <span><%= account.active ? 'Active account' : 'Inactive account' %></span>
          <strong><%= account.name %></strong>
          <small><%= account.email %></small>
          <small><%= account.createdAt ? new Date(account.createdAt).toLocaleString() : '' %></small>
        </p>
      <% }) %>
    </div>
  </section>

  <div class="technician-filterbar">
    <a class="status-filter <%= !currentStatus ? 'active' : '' %>" href="/dashboard/technicians">All</a>
    <% statuses.forEach((status) => { %>
      <a class="status-filter <%= currentStatus === status ? 'active' : '' %>" href="/dashboard/technicians?status=<%= encodeURIComponent(status) %>"><%= status %></a>
    <% }) %>
  </div>

  <section class="dashboard-panel">
    <% if (!items.length) { %>
      <p>No technician applications yet.</p>
    <% } %>

    <div class="manager-request-list">
      <% items.forEach((item) => { %>
        <article class="manager-request-card technician-manager-card">
          <div class="request-card-head">
            <div>
              <h3><%= item.fullName %></h3>
              <p><%= item.city %><% if (item.serviceArea) { %> • <%= item.serviceArea %><% } %></p>
            </div>
            <span class="status-pill manager-status"><%= item.applicationStatus %></span>
          </div>

          <div class="request-card-grid">
            <p><span>Phone</span><a href="tel:<%= item.phone %>"><%= item.phone %></a></p>
            <p><span>Email</span><strong><%= item.email || 'Not provided' %></strong></p>
            <p><span>Vehicle</span><strong><%= item.vehicle || 'Not provided' %></strong></p>
            <p><span>Stripe Connect</span><strong><%= item.stripeConnectStatus %></strong></p>
            <p><span>Payout</span><strong><%= item.payoutStatus %></strong></p>
            <p><span>Applied</span><strong><%= item.createdAt.toLocaleString() %></strong></p>
          </div>

          <div class="request-message">
            <span>Services</span>
            <p><%= item.servicesOffered && item.servicesOffered.length ? item.servicesOffered.join(', ') : 'Not listed' %></p>
          </div>
          <div class="request-message">
            <span>Tools / Equipment</span>
            <p><%= item.tools || 'Not listed' %></p>
          </div>
          <% if (item.experience) { %>
            <div class="request-message">
              <span>Experience</span>
              <p><%= item.experience %></p>
            </div>
          <% } %>

          <% if (item.photoPaths && item.photoPaths.length) { %>
            <div class="photo-strip">
              <% item.photoPaths.forEach((photo) => { %>
                <a href="<%= photo %>" target="_blank" rel="noreferrer"><img src="<%= photo %>" alt="Technician uploaded tool photo"></a>
              <% }) %>
            </div>
          <% } %>

          <form class="manager-update-row" action="/dashboard/technicians/<%= item._id %>/status?_method=PATCH" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="technician-status-actions">
              <button class="btn primary" type="submit" name="applicationStatusAction" value="Approved">Approve</button>
              <button class="btn secondary" type="submit" name="applicationStatusAction" value="Reviewing">Pending / Reviewing</button>
              <button class="btn ghost danger-action" type="submit" name="applicationStatusAction" value="Rejected">Reject</button>
            </div>
            <label>Status
              <select name="applicationStatus">
                <% statuses.forEach((status) => { %>
                  <option <%= status === item.applicationStatus ? 'selected' : '' %>><%= status %></option>
                <% }) %>
              </select>
            </label>
            <label>Connect
              <select name="stripeConnectStatus">
                <% ['Not Started', 'Pending', 'Active', 'Restricted'].forEach((status) => { %>
                  <option <%= status === item.stripeConnectStatus ? 'selected' : '' %>><%= status %></option>
                <% }) %>
              </select>
            </label>
            <label>Payout
              <select name="payoutStatus">
                <% ['Not Ready', 'Ready'].forEach((status) => { %>
                  <option <%= status === item.payoutStatus ? 'selected' : '' %>><%= status %></option>
                <% }) %>
              </select>
            </label>
            <label>Notes
              <input name="notes" value="<%= item.notes || '' %>" placeholder="Internal note">
            </label>
            <button class="btn primary" type="submit">Save Details</button>
          </form>
        </article>
      <% }) %>
    </div>
  </section>
</main>
</body>
</html>
