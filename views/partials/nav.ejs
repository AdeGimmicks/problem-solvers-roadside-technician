<header class="site-header">
  <a class="brand" href="/" aria-label="<%= settings.businessName %> home">
    <img class="brand-logo" src="/images/brand/problem-solvers-icon.png" alt="" aria-hidden="true">
    <span><%= settings.businessName %></span>
  </a>
  <div class="header-contact" aria-label="Call or text <%= settings.businessName %>">
    <a class="header-phone" href="tel:<%= settings.phoneNumber %>">(312) 900-7711</a>
    <span class="header-contact-actions">
      <a href="tel:<%= settings.phoneNumber %>">Call</a>
      <a href="sms:<%= settings.textNumber %>">Text</a>
    </span>
  </div>
  <button class="nav-toggle" type="button" aria-label="Open navigation" data-nav-toggle>☰</button>
  <nav class="site-nav" data-nav>
    <a href="/services">Services</a>
    <a href="/about">About</a>
    <a href="/contact">Contact</a>
    <a class="nav-cta" href="/request-service">Request Service</a>
  </nav>
</header>
