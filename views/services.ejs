<%- include('partials/head') %>
<%- include('partials/nav') %>
<main>
  <section class="services-landing">
    <section class="image-feature home-banner services-landing-banner">
      <img src="/images/brand/ps-hero-clean.png" alt="Problem Solvers Roadside Assistance hero banner with technician, service vehicle, and we come to you message">
    </section>

    <section class="services-landing-hero" aria-labelledby="services-landing-title">
      <div class="services-landing-copy">
        <p class="eyebrow">Roadside help without the wait</p>
        <h1 id="services-landing-title">Reliable Roadside Assistance, Fast</h1>
        <p>Flat tire, dead battery, lockout, fuel delivery, battery service, or roadside help. Choose what you need and keep your phone nearby.</p>
        <div class="hero-actions services-landing-actions">
          <a class="btn primary" href="/">Get Started</a>
          <a class="btn secondary" href="tel:<%= settings.phoneNumber %>">Call Now</a>
          <a class="btn ghost" href="sms:<%= settings.phoneNumber %>">Text Now</a>
        </div>
      </div>
      <div class="services-landing-points" aria-label="How roadside help works">
        <div>
          <strong>1</strong>
          <span>Tell us the service you need.</span>
        </div>
        <div>
          <strong>2</strong>
          <span>Share your vehicle and location.</span>
        </div>
        <div>
          <strong>3</strong>
          <span>We call or text to confirm the job.</span>
        </div>
      </div>
    </section>
  </section>

  <section class="section services-page-grid" aria-labelledby="direct-services-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Roadside services</p>
        <h2 id="direct-services-title">Choose The Help You Need</h2>
      </div>
    </div>
    <div class="direct-service-grid services-direct-grid">
      <% directServicePages.forEach((service) => { %>
        <a class="direct-service-card services-direct-card" href="/<%= service.slug %>">
          <span><%= service.icon %></span>
          <h3><%= service.name %></h3>
          <p><%= service.summary %></p>
          <strong>Starting at <%= service.price %></strong>
        </a>
      <% }) %>
    </div>
  </section>

  <section class="section home-panel-section">
    <div class="section-heading">
      <p class="eyebrow">Reviews</p>
      <h2>Customer feedback</h2>
    </div>
    <div class="review-grid">
      <% const fallbackReviews = (typeof reviews !== 'undefined' && reviews.length) ? reviews : [
        { customerName: 'Illinois Driver', quote: 'Fast response and professional service when my battery died.', rating: 5 },
        { customerName: 'South Side Customer', quote: 'Helped with a flat tire at my location and got me moving again.', rating: 5 },
        { customerName: 'Suburban Driver', quote: 'Clear communication, reliable arrival, and friendly roadside help.', rating: 5 }
      ]; %>
      <% fallbackReviews.forEach((review) => { %>
        <article class="review">
          <div class="stars"><%= '★'.repeat(review.rating || 5) %></div>
          <p>“<%= review.quote %>”</p>
          <strong><%= review.customerName %></strong>
        </article>
      <% }) %>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
