<%- include('partials/head') %>
<%- include('partials/nav') %>
<main>
  <section class="page-hero request-hero">
    <p>Fill this out and keep your phone nearby. We will call or text to confirm the job.</p>
  </section>
  <section class="form-layout single request-layout">
    <form class="form-card wide request-card" action="/request-service" method="post" enctype="multipart/form-data" data-request-form novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <%- include('partials/form-errors', { errors }) %>
      <ol class="request-progress" data-request-progress aria-label="Request progress">
        <li class="is-active" data-progress-step="service"><span>1</span><strong>Service</strong></li>
        <li data-progress-step="details"><span>2</span><strong>Details</strong></li>
        <li data-progress-step="vehicle"><span>3</span><strong>Vehicle</strong></li>
        <li data-progress-step="contact"><span>4</span><strong>Contact</strong></li>
        <li data-progress-step="summary"><span>5</span><strong>Pay</strong></li>
      </ol>
      <input type="hidden" name="preferredPaymentMethod" value="Card">
      <input type="hidden" name="serviceDetails" data-service-details-field>
      <section class="request-step" data-request-step="service">
        <div class="request-step-heading">
          <p class="step-label">Choose your service</p>
          <p>Select the roadside help you need. Your estimate will show before payment.</p>
        </div>
        <label>Service
          <select name="problem" required>
            <option value="">Select service</option>
            <% ['Tire Change', 'Jump Start', 'Fuel Delivery', 'Lockout Service', 'Tire Inflation'].forEach((problem) => { %>
              <option <%= (form.problem || '') === problem ? 'selected' : '' %>><%= problem %></option>
            <% }) %>
          </select>
        </label>
        <div class="selected-service-card">
          <span data-selected-service-icon>◎</span>
          <div>
            <strong data-selected-service-name>Select a service</strong>
            <p data-selected-service-copy>Choose the service so we can ask the right questions.</p>
          </div>
        </div>
        <div class="form-actions">
          <button class="btn primary" type="button" data-step-next>Continue</button>
        </div>
      </section>

      <section class="request-step" data-request-step="details" hidden>
        <div class="request-step-heading">
          <p class="step-label">Describe the situation</p>
          <p>Answer a few quick questions so the technician knows what to bring.</p>
        </div>
        <div class="selected-service-card compact">
          <span data-selected-service-icon>◎</span>
          <div>
            <strong data-selected-service-name>Select a service</strong>
            <p data-selected-service-copy>Choose the service so we can ask the right questions.</p>
          </div>
        </div>
        <div class="service-question-list" data-service-questions></div>
        <div class="form-actions">
          <button class="btn ghost" type="button" data-step-back>Go Back</button>
          <button class="btn primary" type="button" data-step-next>Continue</button>
        </div>
        <div class="service-block-message" data-service-block-message hidden></div>
      </section>

      <section class="request-step" data-request-step="vehicle" hidden>
        <p class="step-label">Vehicle details</p>
        <div class="form-grid">
          <label>Vehicle Make<input name="vehicleMake" value="<%= form.vehicleMake || '' %>" list="vehicleMakes" placeholder="Start typing make" autocomplete="new-password" autocapitalize="words" data-vehicle-make required></label>
          <label>Vehicle Model<input name="vehicleModel" value="<%= form.vehicleModel || '' %>" list="vehicleModels" placeholder="Choose make first, then type model" autocomplete="new-password" autocapitalize="words" data-vehicle-model required></label>
          <label>Vehicle Color<input name="vehicleColor" value="<%= form.vehicleColor || '' %>" placeholder="Vehicle color" autocapitalize="words" required></label>
          <label>Vehicle Year
            <input name="vehicleYear" value="<%= form.vehicleYear || '' %>" list="vehicleYears" inputmode="numeric" maxlength="4" pattern="[0-9]{4}" placeholder="Type any 4-digit year" required>
          </label>
          <label>Selected Service<input value="" data-selected-service-readonly readonly></label>
        </div>
        <div class="form-actions">
          <button class="btn ghost" type="button" data-step-back>Go Back</button>
          <button class="btn primary" type="button" data-step-next>Continue</button>
        </div>
      </section>

      <section class="request-step" data-request-step="contact" hidden>
        <p class="step-label">Contact and location</p>
        <div class="form-grid">
          <label>Customer Name<input name="customerName" value="<%= form.customerName || '' %>" placeholder="Your name" required></label>
          <label>Phone<input type="tel" name="phone" value="<%= form.phone || '' %>" placeholder="Your phone number" required></label>
          <label>Email<input type="email" name="email" value="<%= form.email || '' %>" placeholder="Optional"></label>
          <label>Current Location
            <span class="address-field">
              <input name="currentLocation" value="<%= form.currentLocation || '' %>" placeholder="Enter your current street address" autocomplete="off" data-address-autocomplete required>
              <span class="address-suggestions" data-address-suggestions hidden></span>
            </span>
            <button class="btn ghost location-btn" type="button" data-use-location>Use My Current Location</button>
          </label>
          <label>Photo Upload<input type="file" name="photos" accept="image/jpeg,image/png,image/heic,image/heif" multiple data-photo-upload><small>Upload up to 5 JPG, PNG, or HEIC images.</small></label>
        </div>
        <label>Message<textarea name="message" placeholder="Tell us anything helpful: parking lot, side street, tire position, battery issue, etc."><%= form.message || '' %></textarea></label>
        <div class="form-actions">
          <button class="btn ghost" type="button" data-step-back>Go Back</button>
          <button class="btn primary" type="button" data-step-next>Review Quote</button>
        </div>
      </section>

      <section class="request-step" data-request-step="summary" hidden>
        <div class="request-step-heading">
          <p class="step-label">Service summary</p>
          <p>Review the request, then continue to secure payment.</p>
        </div>
        <section class="quote-panel request-quote-panel" data-quote-panel hidden>
          <p class="eyebrow">Estimated quote</p>
          <div class="quote-grid total-only">
            <p><span>Total estimate</span><strong data-quote-total>$0</strong></p>
          </div>
          <small>This total is calculated before payment based on the selected service and service location.</small>
          <small>Final pricing is based on the information provided. Additional charges may apply if the actual situation differs from the information submitted during the request.</small>
        </section>
        <div class="request-summary-grid">
          <p><span>Service</span><strong data-summary-service>Service</strong></p>
          <p><span>Vehicle</span><strong data-summary-vehicle>Vehicle</strong></p>
          <p><span>Location</span><strong data-summary-location>Location</strong></p>
          <p><span>Estimated Arrival</span><strong data-summary-arrival>Calculated at review</strong></p>
        </div>
        <div class="form-actions">
          <button class="btn ghost" type="button" data-step-back>Go Back</button>
          <button class="btn primary" type="submit" data-submit-request>Pay Now</button>
        </div>
        <div class="payment-reassurance">
          <p><span>Secure Payment</span> Your payment is processed securely through Stripe. Once your payment is confirmed, your technician will be dispatched to the service location.</p>
        </div>
      </section>
      <input type="hidden" name="basePrice" data-quote-field="basePrice">
      <input type="hidden" name="travelFee" data-quote-field="travelFee">
      <input type="hidden" name="totalPrice" data-quote-field="totalPrice">
      <input type="hidden" name="distanceMiles" data-quote-field="distanceMiles">
      <input type="hidden" name="travelTimeMinutes" data-quote-field="travelTimeMinutes">
      <input type="hidden" name="estimatedArrivalMinutes" data-quote-field="estimatedArrivalMinutes">
      <input type="hidden" name="referenceNumber" data-quote-field="referenceNumber">
      <input type="hidden" name="travelEstimateStatus" data-quote-field="travelEstimateStatus">
      <input type="hidden" name="travelEstimateSource" data-quote-field="travelEstimateSource">
      <input type="hidden" name="locationLat" data-location-lat>
      <input type="hidden" name="locationLng" data-location-lng>
      <section class="confirmation-panel" data-confirmation-panel hidden>
        <h2>Request received.</h2>
        <p>Reference number: <strong data-reference-number></strong></p>
        <p>Estimated arrival time: <strong data-arrival-time></strong></p>
        <p>Selected payment method: <strong data-confirm-payment></strong></p>
      </section>
      <datalist id="vehicleMakes"></datalist>
      <datalist id="vehicleModels"></datalist>
      <datalist id="vehicleYears">
        <% for (let year = 2027; year >= 1980; year--) { %><option value="<%= year %>"><% } %>
      </datalist>
    </form>
  </section>
</main>
<%- include('partials/footer') %>
